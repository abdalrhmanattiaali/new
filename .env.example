# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Weather API Configuration (Optional - get from https://openweathermap.org/api)
# If not provided, weather will be estimated based on season
WEATHER_API_KEY=your_openweather_api_key_here

# Database Configuration
DATABASE_PATH=./data/family_assistant.db

# Encryption Key (generate a random 32-character string)
ENCRYPTION_KEY=your_32_character_encryption_key

# Configuration File Path
CONFIG_PATH=./config/config.yaml

# Environment
NODE_ENV=development

# Optional: Redis for caching (if using Redis)
# REDIS_URL=redis://localhost:6379

# Optional: Webhook URL for notifications
# WEBHOOK_URL=https://your-webhook-url.com
