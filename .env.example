# AI API Configuration
# ملاحظة: API Keys مضمنة مباشرة في الكود، لا حاجة لإضافتها هنا
# الملفات: src/utils/claudeClient.js و src/ai/llm.js

# Weather API Configuration
# يستخدم التطبيق Open-Meteo API - مجانية 100% بدون API Key
# https://open-meteo.com/

# Database Configuration
DATABASE_PATH=./data/family_assistant.db

# Encryption Key (generate a random 32-character string)
ENCRYPTION_KEY=your_32_character_encryption_key

# Configuration File Path
CONFIG_PATH=./config/config.yaml

# Environment
NODE_ENV=development

# Optional: Redis for caching (if using Redis)
# REDIS_URL=redis://localhost:6379

# Optional: Webhook URL for notifications
# WEBHOOK_URL=https://your-webhook-url.com
